<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Smartnet.Domain\Smartnet.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.7.1" />

    <!--
      Transitive packages pinned to patched versions. Both arrive through a dependency that has not yet
      taken the fix itself, and NuGet audit fails the restore (warnings are errors) until they are raised:
        MySqlConnector, via Pomelo.EntityFrameworkCore.MySql 9.0.0 — GHSA-473q-m89c-ghf8, fixed in 2.6.1.
        System.Security.Cryptography.Pkcs, via MailKit/MimeKit — GHSA-2fmv-rv2c-59x7 and
          GHSA-846f-f764-76mx, fixed in 10.0.13.
      Drop each pin once its parent package depends on a fixed version.
    -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
